<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.marcosmoreiradev</groupId>
    <artifactId>docupodcast-studio</artifactId>
    <version>0.0.1-onboarding</version>
    <name>DocuPodcast Studio</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <docupodcast.app.heap>-Xmx2048m</docupodcast.app.heap>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <lecturestudio.stylus.version>0.3.0</lecturestudio.stylus.version>
        <lecturestudio.stylus.native.jar>${project.build.directory}/native/stylus-${lecturestudio.stylus.version}-windows-x86_64.jar</lecturestudio.stylus.native.jar>
        <docupodcast.ink.inputDiagnostics>false</docupodcast.ink.inputDiagnostics>
        <docupodcast.ink.renderDiagnostics>false</docupodcast.ink.renderDiagnostics>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lecturestudio.stylus</groupId>
            <artifactId>stylus-javafx</artifactId>
            <version>${lecturestudio.stylus.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.lecturestudio.stylus</groupId>
            <artifactId>stylus</artifactId>
            <version>${lecturestudio.stylus.version}</version>
            <classifier>windows-x86_64</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>jbig2-imageio</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>21</version>
                            <vendor>temurin</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <jdkToolchain>
                        <version>21</version>
                        <vendor>temurin</vendor>
                    </jdkToolchain>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-stylus-native</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.lecturestudio.stylus</groupId>
                                    <artifactId>stylus</artifactId>
                                    <version>${lecturestudio.stylus.version}</version>
                                    <classifier>windows-x86_64</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}/native</outputDirectory>
                                    <destFileName>stylus-${lecturestudio.stylus.version}-windows-x86_64.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.marcosmoreiradev.docupodcaststudio/com.marcosmoreiradev.docupodcaststudio.DocuPodcastStudioApp</mainClass>
                    <options>
                        <option>${docupodcast.app.heap}</option>
                        <option>--patch-module=stylus=${lecturestudio.stylus.native.jar}</option>
                        <option>-Ddocupodcast.ink.inputDiagnostics=${docupodcast.ink.inputDiagnostics}</option>
                        <option>-Ddocupodcast.ink.renderDiagnostics=${docupodcast.ink.renderDiagnostics}</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <jdkToolchain>
                        <version>21</version>
                        <vendor>temurin</vendor>
                    </jdkToolchain>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
