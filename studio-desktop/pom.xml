<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.marcosmoreiradev</groupId>
    <artifactId>docupodcast-studio</artifactId>
    <version>0.0.1-onboarding</version>
    <name>DocuPodcast Studio Desktop</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <docupodcast.app.heap>-Xmx2048m</docupodcast.app.heap>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javafx.version>21.0.2</javafx.version>
        <lecturestudio.stylus.version>0.3.0</lecturestudio.stylus.version>
        <lecturestudio.stylus.native.jar>../target/native/stylus-${lecturestudio.stylus.version}-windows-x86_64.jar</lecturestudio.stylus.native.jar>
        <docupodcast.ink.inputDiagnostics>false</docupodcast.ink.inputDiagnostics>
        <docupodcast.ink.renderDiagnostics>false</docupodcast.ink.renderDiagnostics>
        <junit.version>5.10.2</junit.version>
        <archunit.version>1.4.2</archunit.version>
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.18</logback.version>
        <testfx.version>4.0.17</testfx.version>
        <monocle.version>21.0.2</monocle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.marcosmoreiradev</groupId>
            <artifactId>studio-media-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcosmoreiradev</groupId>
            <artifactId>studio-ink</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.marcosmoreiradev</groupId>
            <artifactId>studio-local-media-adapters</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version></dependency>
        <dependency>
            <groupId>org.lecturestudio.stylus</groupId><artifactId>stylus-javafx</artifactId><version>${lecturestudio.stylus.version}</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId></exclusion></exclusions>
        </dependency>
        <dependency><groupId>org.lecturestudio.stylus</groupId><artifactId>stylus</artifactId><version>${lecturestudio.stylus.version}</version><classifier>windows-x86_64</classifier><scope>runtime</scope></dependency>
        <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.7</version></dependency>
        <dependency><groupId>org.apache.pdfbox</groupId><artifactId>jbig2-imageio</artifactId><version>3.0.5</version></dependency>
        <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.19.1</version></dependency>
        <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna-platform</artifactId><version>5.19.1</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>${slf4j.version}</version></dependency>
        <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><version>${logback.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.testfx</groupId><artifactId>testfx-core</artifactId><version>${testfx.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.testfx</groupId><artifactId>testfx-junit5</artifactId><version>${testfx.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.testfx</groupId><artifactId>openjfx-monocle</artifactId><version>${monocle.version}</version><scope>test</scope></dependency>
    </dependencies>

    <build>
        <directory>${maven.multiModuleProjectDirectory}/target</directory>
        <sourceDirectory>${maven.multiModuleProjectDirectory}/src/main/java</sourceDirectory>
        <testSourceDirectory>${maven.multiModuleProjectDirectory}/src/test/java</testSourceDirectory>
        <resources>
            <resource><directory>${maven.multiModuleProjectDirectory}/src/main/resources</directory></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-toolchains-plugin</artifactId><version>3.2.0</version>
                <executions><execution><goals><goal>toolchain</goal></goals></execution></executions>
                <configuration><toolchains><jdk><version>21</version><vendor>temurin</vendor></jdk></toolchains></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.12.1</version>
                <configuration><release>${maven.compiler.release}</release><jdkToolchain><version>21</version><vendor>temurin</vendor></jdkToolchain></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
                <executions><execution><id>copy-stylus-native</id><phase>process-resources</phase><goals><goal>copy</goal></goals>
                    <configuration><artifactItems><artifactItem>
                        <groupId>org.lecturestudio.stylus</groupId><artifactId>stylus</artifactId><version>${lecturestudio.stylus.version}</version>
                        <classifier>windows-x86_64</classifier><type>jar</type><outputDirectory>${maven.multiModuleProjectDirectory}/target/native</outputDirectory>
                        <destFileName>stylus-${lecturestudio.stylus.version}-windows-x86_64.jar</destFileName>
                    </artifactItem></artifactItems></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
                <configuration>
                    <mainClass>com.marcosmoreiradev.docupodcaststudio/com.marcosmoreiradev.docupodcaststudio.DocuPodcastStudioApp</mainClass>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <options>
                        <option>${docupodcast.app.heap}</option>
                        <option>-Dfile.encoding=UTF-8</option>
                        <option>--patch-module</option>
                        <option>stylus=${lecturestudio.stylus.native.jar}</option>
                        <option>-Ddocupodcast.ink.inputDiagnostics=${docupodcast.ink.inputDiagnostics}</option>
                        <option>-Ddocupodcast.ink.renderDiagnostics=${docupodcast.ink.renderDiagnostics}</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
                <configuration>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <jdkToolchain><version>21</version><vendor>temurin</vendor></jdkToolchain>
                    <excludes><exclude>**/*E2ETest.java</exclude></excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>gui-e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <includes><include>**/*E2ETest.java</include></includes>
                            <argLine>
                                --add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                                --add-exports=javafx.graphics/com.sun.glass.events=ALL-UNNAMED
                                --add-exports=javafx.graphics/com.sun.glass.utils=ALL-UNNAMED
                                --add-exports=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                                --add-exports=javafx.graphics/com.sun.javafx.tk=ALL-UNNAMED
                                --add-exports=javafx.graphics/com.sun.javafx.util=ALL-UNNAMED
                                --add-exports=javafx.base/com.sun.javafx.logging=ALL-UNNAMED
                                --add-opens=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
                                --add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                            </argLine>
                            <systemPropertyVariables>
                                <testfx.robot>glass</testfx.robot>
                                <testfx.headless>true</testfx.headless>
                                <glass.platform>Monocle</glass.platform>
                                <monocle.platform>Headless</monocle.platform>
                                <prism.order>sw</prism.order>
                                <prism.text>t2k</prism.text>
                                <java.awt.headless>true</java.awt.headless>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
