<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.marcosmoreiradev</groupId>
    <artifactId>studio-local-media-adapters</artifactId>
    <version>0.0.1-onboarding</version>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.10.2</junit.version>
        <mathcat4j.version>0.7.2-2</mathcat4j.version>
        <jspecify.version>1.0.0</jspecify.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.marcosmoreiradev</groupId>
            <artifactId>studio-media-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>onl.mdw</groupId>
            <artifactId>mathcat4j-jni-loader-jna</artifactId>
            <version>${mathcat4j.version}</version>
        </dependency>
        <!-- mathcat4j.jni declares a JPMS dependency that its published POM
             does not currently bring onto the runtime module path. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration><release>${maven.compiler.release}</release></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration><useModulePath>false</useModulePath></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>bundle-mathcat-rules</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>onl.mdw</groupId>
                                    <artifactId>mathcat4j-jni</artifactId>
                                    <version>${mathcat4j.version}</version>
                                    <classifier>rules</classifier>
                                    <type>zip</type>
                                    <outputDirectory>${project.build.outputDirectory}/mathcat</outputDirectory>
                                    <destFileName>mathcat-rules.zip</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
